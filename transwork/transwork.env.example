# Image tag used by the Gressio Docker overlay.
IMAGE_TAG=transwork-server:latest

# Host path to the Google Cloud service account JSON file.
# Paths are resolved from the repository root when using:
#   docker compose --env-file transwork/transwork.env -f docker-compose.yml -f transwork/docker-compose.transwork.yml up -d --build
TRANSWORK_GCS_KEY_PATH=./transwork/key.json

# Google Cloud Storage bucket for batch ASR uploads.
GCS_BUCKET_NAME=longway-ai

# Comma-separated CIDRs allowed to set X-Forwarded-For. Everything IP-keyed depends on
# this: the rate limiters, the per-token IP allowlist, and Turnstile. Trust ONLY the
# reverse proxy hop in front of the app — anything wider lets that host spoof client IPs.
#
# The compose overlay already defaults this to loopback plus the Docker bridge pool
# (172.16.0.0/12), which is correct for the nginx-on-host deployment. Set it here only to
# pin something narrower, or when the topology changes:
#   - a CDN/load balancer in front  -> the provider's ranges IN ADDITION TO the bridge,
#     never instead of it. Gin consults X-Forwarded-For only once the *immediate* peer
#     is trusted, and behind this overlay the immediate peer is always the Docker bridge
#     gateway (the CDN talks to nginx, nginx talks to the container). Replace the bridge
#     with provider ranges and ClientIP() falls back to the gateway for every request,
#     collapsing the rate limiters, the token IP allowlist and Turnstile onto one IP.
#   - app exposed directly, no proxy -> empty string (trust nothing, use RemoteAddr)
# The application's own default is loopback-only, so it fails closed if this is unset.
#TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# Whether the session cookie carries the Secure attribute, i.e. whether the browser is
# forbidden from ever sending it over cleartext HTTP. The compose overlay already pins
# this to true, which is correct for the nginx-on-host deployment; the application's own
# default is false, matching upstream's plain-HTTP-capable behaviour.
#
# Set it to false here ONLY when the dashboard is genuinely served over plain HTTP from a
# non-loopback host, because a Secure cookie there breaks login: the browser accepts the
# Set-Cookie and then never sends it back, so password login, OAuth state validation and
# the passkey begin/finish pair all fail to persist a session. `http://localhost` is a
# secure context in every current browser, so running the compose stack locally does NOT
# need this. Parsed with strconv.ParseBool ("true"/"1"/"t" and "false"/"0"/"f" all work);
# an unparseable value such as "ture" or "yes" ABORTS STARTUP rather than falling back,
# so a typo here cannot quietly leave the cookie non-Secure in production.
#SESSION_COOKIE_SECURE=true

# Object-storage backend for audio upload/transcription flows.
# Currently only "gcs" (the default when unset) is implemented; the ObjectStore
# interface in transwork/storage/store.go is where an S3/R2 backend would plug in.
#STORAGE_PROVIDER=gcs

# ElevenLabs API key used by the server for batch transcription.
ELEVENLABS_API_KEY=replace_me
